# Copy to ~/.config/packetbot/env and protect it: chmod 600 ~/.config/packetbot/env
# Never commit this file or paste its values in a chat.

# PHPSESSID of wordgalaxy.space (several accounts: separated by commas).
PACKETBOT_PHPSESSID=
# Telegram (optional): BotFather token and numeric ID of your private chat.
PACKETBOT_TELEGRAM_TOKEN=
PACKETBOT_TELEGRAM_CHAT_ID=
# Web panel (optional): password of at least 8 characters, and its port.
# Plain HTTP: publish it only through an HTTPS reverse proxy.
PACKETBOT_WEB_PASSWORD=
# PACKETBOT_WEB_PORT=8080
# Extra arguments for the service, e.g. start a module after logging in:
#   --start collect | --start npc | --start gg
PACKETBOT_ARGS=
